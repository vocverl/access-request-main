# GRC-connector configuratie
#
# Kopieer de regels die je nodig hebt naar .env (NIET .env overschrijven -
# daar staan nu nog Spotify-tokens van een ander project in).
# .env staat in .gitignore en komt dus nooit in git terecht.

# --- Verbinding met GRD ---------------------------------------------------
GRC_BASE_URL=https://grc-dev.vitens.lan
GRC_CLIENT=100
GRC_USERNAME=RFC_ARQ

# Vul dit zelf in. Laat de waarde nooit in git of in een chat belanden.
GRC_PASSWORD=

GRC_TIMEOUT_MS=30000

# --- TLS -----------------------------------------------------------------
# Het certificaat van grc-dev is uitgegeven door de interne Vitens-CA, die
# Node niet kent. Wijs naar een PEM-bestand met die CA:
GRC_TLS_CA_FILE=

# Noodrem voor lokaal testen: schakelt certificaatvalidatie uit.
# Alleen op 'true' zetten als je even niet aan de CA kunt komen, en nooit
# op een server. De connector logt een waarschuwing zolang dit aan staat.
GRC_TLS_INSECURE=false

# --- Endpoints -----------------------------------------------------------
# Vul per service de "Calculated Access URL" in die SOAMANAGER laat zien,
# als pad (dus zonder https://grc-dev.vitens.lan ervoor).
GRC_EP_SEARCH_ROLES=
GRC_EP_USER_ACCESS=
GRC_EP_REQUEST_STATUS=
GRC_EP_REQUEST_DETAILS=

# --- Operatienamen -------------------------------------------------------
# De connector heeft een gok als standaardwaarde. Zodra je de echte namen uit
# de WSDL kent (GET /api/debug/wsdl?service=searchRoles), zet je ze hier -
# dan hoeft er geen code aangepast te worden.
GRC_OP_SEARCH_ROLES=
GRC_OP_USER_ACCESS=
GRC_OP_REQUEST_STATUS=
GRC_OP_REQUEST_DETAILS=

# --- Ontwikkelhulp -------------------------------------------------------
# Zet de /api/debug/* routes aan. Die hebben we nodig om de WSDL op te halen
# en het SOAP-formaat uit te vogelen. Uit zetten voordat dit ergens anders
# dan op localhost draait.
ENABLE_DEBUG_ENDPOINTS=true

# --- WSDL ------------------------------------------------------------------
# Deze SAP-versie serveert de WSDL niet op "<endpoint>?wsdl". Neem het prefix
# over uit SOAMANAGER, veld "WSDL-URL voor binding" - alleen het deel voor het
# endpointpad, dus t/m /bndg_url.
GRC_WSDL_PREFIX=

# --- Waardelijsten (GRAC_LOOKUP_WS) --------------------------------------
# Optioneel. Hiermee vraagt de connector geldige codes op bij GRC in plaats
# van ze hardgecodeerd te hebben - zie GET /api/lookup?lists=priorityType
GRC_EP_LOOKUP=
GRC_OP_LOOKUP=

# --- Identiteit -----------------------------------------------------------
# Hoe de connector vaststelt wie er achter de browser zit. Zie server/auth.js.
#
#   local  - ontwikkelmodus. Vaste gebruiker uit LOCAL_USER_ID.
#   header - achter een SSO-proxy die de aangemelde gebruiker in een header
#            zet. Vul dan AUTH_TRUSTED_PROXIES met de adressen van die proxy;
#            zonder die lijst wordt de header genegeerd, want anders kan
#            iedereen die het proces bereikt zelf een naam meesturen.
AUTH_MODE=local
LOCAL_USER_ID=
AUTH_HEADER=x-remote-user
AUTH_TRUSTED_PROXIES=
